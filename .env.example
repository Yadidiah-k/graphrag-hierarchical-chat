OPENAI_API_KEY=
# Leave OPENAI_BASE_URL unset to use api.openai.com directly. Pointing it at
# an OpenAI-compatible endpoint (e.g. OpenRouter) lets OPENAI_API_KEY hold
# that provider's key instead, with no code changes:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=<your OpenRouter key>
#   LLM_MODEL=<any OpenRouter model id, e.g. a free one like liquid/lfm-2.5-2.6b:free>
#   EMBEDDING_MODEL=openai/text-embedding-3-small   # OpenRouter's embeddings endpoint expects the openai/ prefix
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
NEO4J_PASSWORD=testpassword
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=graphrag
POSTGRES_DB=graphrag

# LangSmith tracing (optional). LangChain/LangGraph auto-detect these three
# vars from the environment -- no application code change is needed for
# tracing itself to work once they're set. Get an API key at
# smith.langchain.com, then uncomment and fill these in:
#   LANGCHAIN_TRACING_V2=true
#   LANGCHAIN_API_KEY=<your LangSmith key>
#   LANGCHAIN_PROJECT=graphrag
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
